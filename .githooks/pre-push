#!/bin/bash
# lingxi pre-push：推送前在本地先跑历史闸 + 密钥扫描，旧历史在本机就被拦下。
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"
fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  python3 scripts/ci/guard.py history "$local_sha" || fail=1
  if command -v gitleaks >/dev/null 2>&1; then
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
    gitleaks git . --redact --no-banner --log-opts="$range" >/tmp/.gl-pre-push.out 2>&1 || {
      echo "❌ gitleaks 在待推送提交里发现疑似密钥："; grep -E 'RuleID|File|Commit' /tmp/.gl-pre-push.out | head -20; fail=1; }
  fi
done
[ $fail -ne 0 ] && echo "推送已拦截。不要 --no-verify 绕过，先把问题修掉。"
exit $fail
