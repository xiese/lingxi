# 知识库环境变量示例
#
# 用法：用 export 传入，或在 systemd 单元里用 EnvironmentFile= 指向本文件的副本。
# 注意：程序不会自动读取 .env，本文件只是清单与注释示例。
# 密钥类变量不要提交到版本库（.env 已在 .gitignore 中）。

# ── 库根目录 ──
# 笔记与运行期状态文件（令牌、索引、审计库）的存放位置。
# 不设置时默认取本仓库根目录。
KB_ROOT=/srv/knowledge-base

# ── REST API 服务 ──
# 监听地址。默认 127.0.0.1 只允许本机访问；
# 需要对外提供服务时改为 0.0.0.0，并务必配置反向代理与 HTTPS。
KB_HOST=127.0.0.1
KB_PORT=8899

# 反向代理可信来源（逗号分隔的 IP）。
# 只有请求来自这里列出的地址时，才采信 X-Forwarded-For / X-Real-IP；
# 否则一律使用 TCP 对端地址，避免伪造请求头绕过限流与审计。
# 例：KB_TRUSTED_PROXIES=127.0.0.1,192.0.2.1
# KB_TRUSTED_PROXIES=

# ── 客户端连接 ──
# kb-cli / 脚本 / MCP 客户端使用的 API 地址
KB_API=http://127.0.0.1:8899
# 访问令牌（主令牌或设备令牌），首次启动后从 $KB_ROOT/.api_tokens.json 获取
# KB_TOKEN=
# KB_MASTER_TOKEN=

# 令牌文件路径（默认 $KB_ROOT/.api_tokens.json）
# KB_TOKEN_FILE=

# ── 检索 ──
# 向量化等待嵌入服务的单次最长秒数；超时本轮降级为关键词检索，不会无限阻塞。
# 默认 120。
# KB_EMB_WAIT_MAX=120

# ── MCP SSE 服务 ──
KB_MCP_SSE_HOST=127.0.0.1
KB_MCP_SSE_PORT=8898
# 对外暴露的 SSE 地址（用于生成分享配置）
KB_MCP_SSE_URL=http://127.0.0.1:8898/sse
# 紧急关闭 SSE 鉴权（不建议）
# KB_MCP_SSE_AUTH=0

# ── MCP 行为 ──
# 只读模式：置 1/true/yes/on 后 MCP 只暴露只读工具，写入类调用直接返回提示
# KB_MCP_READONLY=
# 额外的 SSE 令牌白名单，逗号分隔
# KB_MCP_SSE_TOKENS=
# MCP 上传单文件大小上限（字节），默认 5 MiB
# KB_MCP_UPLOAD_MAX_BYTES=5242880
# MCP 写入笔记时正文最小字符数，低于此值按质量校验拒绝
# KB_MCP_MIN_CONTENT_LEN=800
# MCP 调用统计落盘位置，默认 $KB_ROOT/.kb_mcp_usage.jsonl
# KB_MCP_USAGE_LOG=
# 客户端名称，仅出现在 MCP 调用统计行里
# KB_CLIENT_NAME=

# ── 可选集成 ──
# 告警 webhook（健康检查脚本使用）
# KB_ALERT_WEBHOOK=
# 笔记备份目录与保留天数（备份脚本使用，默认 14 天）
# KB_BACKUP_DIR=
# KB_BACKUP_KEEP_DAYS=14

# ── 外部记忆（可选集成） ──
# 外部记忆文件路径，多个用 ":" 分隔
# KB_MEMORY_FILES=
# 外部记忆数据库路径
# KB_MEMORY_DB=

# ── 技能目录 ──
# /api/skills 读取其中的 SKILL.md；未设置时默认取 ~/.kb-skills
# KB_SKILLS_DIR=

# ── 只读 / 第三方路径（脚本用） ──
# 检索评估脚本使用的服务地址（scripts/kb_eval.py）
KB_URL=http://127.0.0.1:8899
# 检索评估使用的 golden set 路径，默认 tests/golden_search.json
# KB_GOLDEN=
